generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                    String                @id @default(cuid())
  email                 String                @unique
  nombre                String?
  creadoEn              DateTime              @default(now())
  analisisEmpresariales AnalisisEmpresarial[]
  conversaciones        Conversacion[]
  Notas                 Nota[]
  proyectos             ProyectoCodigo[]
}

model Conversacion {
  id        String    @id @default(cuid())
  usuarioId String
  titulo    String?
  creadoEn  DateTime  @default(now())
  usuario   Usuario   @relation(fields: [usuarioId], references: [id])
  mensajes  Mensaje[]
}

model Mensaje {
  id                   String               @id @default(cuid())
  conversacionId       String
  rol                  String
  contenido            String
  creadoEn             DateTime             @default(now())
  ejecucionesHabilidad EjecucionHabilidad[]
  conversacion         Conversacion         @relation(fields: [conversacionId], references: [id])
}

model EjecucionHabilidad {
  id              String   @id @default(cuid())
  mensajeId       String
  nombreHabilidad String
  entrada         Json
  salida          Json?
  exitoso         Boolean  @default(false)
  creadoEn        DateTime @default(now())
  mensaje         Mensaje  @relation(fields: [mensajeId], references: [id])
}

model Nota {
  id         String   @id @default(cuid())
  usuarioId  String
  contenido  String
  completada Boolean  @default(false)
  creadoEn   DateTime @default(now())
  usuario    Usuario  @relation(fields: [usuarioId], references: [id])
}

model AnalisisEmpresarial {
  id        String   @id @default(cuid())
  usuarioId String
  tipo      String
  titulo    String
  contenido String
  creadoEn  DateTime @default(now())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
}


model ProyectoCodigo {
  id          String            @id @default(cuid())
  usuarioId   String
  usuario     Usuario           @relation(fields: [usuarioId], references: [id])
  nombre      String
  descripcion String?
  stack       String
  creadoEn    DateTime          @default(now())
  archivos    ArchivoProyecto[]
}

model ArchivoProyecto {
  id         String         @id @default(cuid())
  proyectoId String
  proyecto   ProyectoCodigo @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  ruta       String
  contenido  String
  creadoEn   DateTime       @default(now())

  @@unique([proyectoId, ruta])
}